#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55a1d1ec9b90 .scope module, "tb_lfsr" "tb_lfsr" 2 3;
 .timescale -9 -12;
v0x55a1d1ef4130_0 .var "clk", 0 0;
v0x55a1d1ef4240_0 .net "data", 7 0, v0x55a1d1ef38d0_0;  1 drivers
v0x55a1d1ef4350_0 .var "data_expected", 7 0;
v0x55a1d1ef4410_0 .var/i "i", 31 0;
v0x55a1d1ef44f0_0 .var "reset_n", 0 0;
S_0x55a1d1ed8d50 .scope module, "lfsr_inst" "lfsr" 2 9, 3 29 0, S_0x55a1d1ec9b90;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /OUTPUT 8 "data";
v0x55a1d1ef3ad0_0 .net "clk", 0 0, v0x55a1d1ef4130_0;  1 drivers
v0x55a1d1ef3ba0_0 .net "data", 7 0, v0x55a1d1ef38d0_0;  alias, 1 drivers
v0x55a1d1ef3c70_0 .net "reset_n", 0 0, v0x55a1d1ef44f0_0;  1 drivers
S_0x55a1d1ed8f30 .scope module, "core" "LFSR" 3 34, 3 2 0, S_0x55a1d1ed8d50;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset_n";
    .port_info 2 /OUTPUT 8 "data";
v0x55a1d1eda0f0_0 .net "clk", 0 0, v0x55a1d1ef4130_0;  alias, 1 drivers
v0x55a1d1ef38d0_0 .var "data", 7 0;
v0x55a1d1ef39b0_0 .net "reset_n", 0 0, v0x55a1d1ef44f0_0;  alias, 1 drivers
E_0x55a1d1e9f6a0/0 .event negedge, v0x55a1d1ef39b0_0;
E_0x55a1d1e9f6a0/1 .event posedge, v0x55a1d1eda0f0_0;
E_0x55a1d1e9f6a0 .event/or E_0x55a1d1e9f6a0/0, E_0x55a1d1e9f6a0/1;
S_0x55a1d1ef3d90 .scope function.vec4.s8, "reference_lfsr_output" "reference_lfsr_output" 2 25, 2 25 0, S_0x55a1d1ec9b90;
 .timescale -9 -12;
v0x55a1d1ef3f70_0 .var "current_state", 7 0;
; Variable reference_lfsr_output is vec4 return value of scope S_0x55a1d1ef3d90
TD_tb_lfsr.reference_lfsr_output ;
    %load/vec4 v0x55a1d1ef3f70_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x55a1d1ef3f70_0;
    %parti/s 1, 0, 2;
    %load/vec4 v0x55a1d1ef3f70_0;
    %parti/s 1, 3, 3;
    %xor;
    %load/vec4 v0x55a1d1ef3f70_0;
    %parti/s 1, 5, 4;
    %xor;
    %load/vec4 v0x55a1d1ef3f70_0;
    %parti/s 1, 6, 4;
    %xor;
    %concat/vec4; draw_concat_vec4
    %ret/vec4 0, 0, 8;  Assign to reference_lfsr_output (store_vec4_to_lval)
    %end;
    .scope S_0x55a1d1ed8f30;
T_1 ;
    %pushi/vec4 138, 0, 8;
    %store/vec4 v0x55a1d1ef38d0_0, 0, 8;
    %end;
    .thread T_1;
    .scope S_0x55a1d1ed8f30;
T_2 ;
    %wait E_0x55a1d1e9f6a0;
    %load/vec4 v0x55a1d1ef39b0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_2.0, 8;
    %pushi/vec4 138, 0, 8;
    %assign/vec4 v0x55a1d1ef38d0_0, 0;
    %jmp T_2.1;
T_2.0 ;
    %load/vec4 v0x55a1d1ef38d0_0;
    %parti/s 7, 0, 2;
    %load/vec4 v0x55a1d1ef38d0_0;
    %parti/s 1, 0, 2;
    %load/vec4 v0x55a1d1ef38d0_0;
    %parti/s 1, 3, 3;
    %xor;
    %load/vec4 v0x55a1d1ef38d0_0;
    %parti/s 1, 5, 4;
    %xor;
    %load/vec4 v0x55a1d1ef38d0_0;
    %parti/s 1, 6, 4;
    %xor;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x55a1d1ef38d0_0, 0;
T_2.1 ;
    %jmp T_2;
    .thread T_2;
    .scope S_0x55a1d1ec9b90;
T_3 ;
    %delay 5000, 0;
    %load/vec4 v0x55a1d1ef4130_0;
    %inv;
    %store/vec4 v0x55a1d1ef4130_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x55a1d1ec9b90;
T_4 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55a1d1ef4130_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55a1d1ef44f0_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55a1d1ef44f0_0, 0, 1;
    %load/vec4 v0x55a1d1ef4240_0;
    %cmpi/ne 138, 0, 8;
    %jmp/0xz  T_4.0, 6;
    %vpi_call 2 43 "$display", "Error: At time %t, data = %b, expected = 10001010", $time, v0x55a1d1ef4240_0 {0 0 0};
    %vpi_call 2 44 "$finish" {0 0 0};
T_4.0 ;
    %pushi/vec4 138, 0, 8;
    %store/vec4 v0x55a1d1ef4350_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55a1d1ef4410_0, 0, 32;
T_4.2 ;
    %load/vec4 v0x55a1d1ef4410_0;
    %cmpi/s 256, 0, 32;
    %jmp/0xz T_4.3, 5;
    %load/vec4 v0x55a1d1ef4350_0;
    %store/vec4 v0x55a1d1ef3f70_0, 0, 8;
    %callf/vec4 TD_tb_lfsr.reference_lfsr_output, S_0x55a1d1ef3d90;
    %store/vec4 v0x55a1d1ef4350_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v0x55a1d1ef4240_0;
    %load/vec4 v0x55a1d1ef4350_0;
    %cmp/ne;
    %jmp/0xz  T_4.4, 6;
    %vpi_call 2 60 "$display", "Error: At time %t, data = %b, expected = %b", $time, v0x55a1d1ef4240_0, v0x55a1d1ef4350_0 {0 0 0};
    %vpi_call 2 61 "$finish" {0 0 0};
T_4.4 ;
    %load/vec4 v0x55a1d1ef4410_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55a1d1ef4410_0, 0, 32;
    %jmp T_4.2;
T_4.3 ;
    %vpi_call 2 66 "$display", "Simulation successful. All test cases passed." {0 0 0};
    %vpi_call 2 67 "$finish" {0 0 0};
    %end;
    .thread T_4;
